// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Monitor {
  id                 String  @id @default(cuid())
  name               String
  url                String
  method             String  @default("GET")
  intervalSeconds    Int     @default(60)
  timeoutMs          Int     @default(5000)
  expectedStatus     Int     @default(200)
  latencyThresholdMs Int     @default(1000)
  enabled            Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  checks    HealthCheck[]
  incidents Incident[]

  @@index([enabled])
  @@index([createdAt])
}

model HealthCheck {
  id           String   @id @default(cuid())
  monitorId    String
  checkedAt    DateTime @default(now()) @db.Timestamptz(3)
  statusCode   Int?
  latencyMs    Int
  success      Boolean
  errorType    String?
  errorMessage String?
  responseSize Int?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@index([success, checkedAt])
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum IncidentEventType {
  OPENED
  RESOLVED
}

model Incident {
  id          String         @id @default(cuid())
  monitorId   String
  title       String
  description String?
  status      IncidentStatus @default(OPEN)

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  monitor Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  events  IncidentEvent[]

  @@index([monitorId, status])
  @@index([startedAt(sort: Desc)])
}

model IncidentEvent {
  id         String            @id @default(cuid())
  incidentId String
  type       IncidentEventType
  message    String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}
